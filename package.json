{
  "name": "gymapp",
  "version": "1.0.6",
  "description": "Administracion de gimnasio: clientes, membresias, asistencias, punto de venta, inventario y caja.",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "test": "electron test/respaldos-wal.js && electron test/respaldos-restaurar.js && electron test/desbloqueo.js && electron test/imagenes.js && electron test/membresias.js && electron test/panel-clientes.js && electron test/huellas.js && electron test/escucha-kiosco.js && electron test/pantalla-kiosco.js && electron test/fuera-de-caja.js && electron test/arranque.js && electron test/caja-detalle.js && electron test/intercambio.js && electron test/sidecar.js && electron test/kiosco-pin.js && electron test/puerta.js && electron test/lector.js && electron test/productos.js && electron test/caja.js && electron test/ventas.js && electron test/fiados.js && electron test/usuarios.js && electron test/dashboard.js && electron test/desarrollador.js && electron test/documento-provisional.js && electron test/recordatorios.js && electron test/ensayo-correos.js",
    "test:respaldos": "electron test/respaldos-wal.js && electron test/respaldos-restaurar.js",
    "test:desbloqueo": "electron test/desbloqueo.js",
    "test:imagenes": "electron test/imagenes.js",
    "test:membresias": "electron test/membresias.js",
    "test:panel-clientes": "electron test/panel-clientes.js",
    "test:huellas": "electron test/huellas.js",
    "test:escucha-kiosco": "electron test/escucha-kiosco.js",
    "test:pantalla-kiosco": "electron test/pantalla-kiosco.js",
    "test:fuera-de-caja": "electron test/fuera-de-caja.js",
    "test:arranque": "electron test/arranque.js",
    "test:caja-detalle": "electron test/caja-detalle.js",
    "test:intercambio": "electron test/intercambio.js",
    "test:sidecar": "electron test/sidecar.js",
    "test:kiosco-pin": "electron test/kiosco-pin.js",
    "test:puerta": "electron test/puerta.js",
    "test:lector": "electron test/lector.js && vite build && electron test/lector-ventana.js",
    "test:productos": "electron test/productos.js",
    "test:caja": "electron test/caja.js",
    "test:ventas": "electron test/ventas.js",
    "test:fiados": "electron test/fiados.js",
    "test:usuarios": "electron test/usuarios.js",
    "test:dashboard": "electron test/dashboard.js",
    "test:desarrollador": "electron test/desarrollador.js",
    "test:documento-provisional": "electron test/documento-provisional.js",
    "test:recordatorios": "electron test/recordatorios.js",
    "test:ensayo-correos": "electron test/ensayo-correos.js",
    "capturas": "vite build && electron scripts/capturas.js",
    "ensayo:restauracion": "electron scripts/ensayo-restauracion.js",
    "icono": "electron scripts/hacer-icono.js",
    "auditoria": "node scripts/auditoria-ipc.js",
    "camara": "electron scripts/diagnostico-camara.js",
    "puerta": "electron scripts/diagnostico-puerta.js",
    "lector": "electron scripts/diagnostico-lector.js",
    "huella": "electron scripts/diagnostico-huella.js",
    "huella:visible": "cross-env GYMAPP_SIDECAR_VISIBLE=1 electron scripts/diagnostico-huella.js --visible",
    "huella:muestra": "electron scripts/muestra-sdk.js",
    "build": "vite build && electron-builder --win",
    "build:dir": "vite build && electron-builder --win --dir",
    "test:produccion": "vite build && electron test/produccion.js && electron test/lector-ventana.js"
  },
  "keywords": [],
  "author": "H.A.M.C Solutions",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serialport": "^13.0.0",
    "uuid": "^14.0.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true
  },
  "build": {
    "appId": "com.gymapp.escritorio",
    "productName": "GymApp",
    "copyright": "H.A.M.C Solutions",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "index.html",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/dev-public.pem",
        "to": "dev-public.pem"
      },
      {
        "from": "sidecar-huella/bin/Release",
        "to": "sidecar",
        "filter": [
          "**/*",
          "!*.pdb",
          "!*.xml"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/argon2/**",
      "**/node_modules/@serialport/**"
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GymApp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GymApp",
      "uninstallDisplayName": "GymApp",
      "deleteAppDataOnUninstall": false
    }
  }
}
