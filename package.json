{
  "name": "gymapp",
  "version": "1.0.0",
  "description": "Administracion de gimnasio: clientes, membresias, asistencias, punto de venta, inventario y caja.",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "test": "node_modules/electron/dist/electron.exe test/respaldos-wal.js && node_modules/electron/dist/electron.exe test/respaldos-restaurar.js && node_modules/electron/dist/electron.exe test/productos.js && node_modules/electron/dist/electron.exe test/caja.js && node_modules/electron/dist/electron.exe test/ventas.js && node_modules/electron/dist/electron.exe test/usuarios.js && node_modules/electron/dist/electron.exe test/dashboard.js",
    "test:respaldos": "node_modules/electron/dist/electron.exe test/respaldos-wal.js && node_modules/electron/dist/electron.exe test/respaldos-restaurar.js",
    "test:productos": "node_modules/electron/dist/electron.exe test/productos.js",
    "test:caja": "node_modules/electron/dist/electron.exe test/caja.js",
    "test:ventas": "node_modules/electron/dist/electron.exe test/ventas.js",
    "test:usuarios": "node_modules/electron/dist/electron.exe test/usuarios.js",
    "test:dashboard": "node_modules/electron/dist/electron.exe test/dashboard.js",
    "build": "vite build && electron-builder --win",
    "build:dir": "vite build && electron-builder --win --dir",
    "test:produccion": "vite build && node_modules/electron/dist/electron.exe test/produccion.js"
  },
  "keywords": [],
  "author": "H.A.M.C Solutions",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^14.0.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true
  },
  "build": {
    "appId": "com.gymapp.escritorio",
    "productName": "GymApp",
    "copyright": "H.A.M.C Solutions",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "index.html",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/dev-public.pem",
        "to": "dev-public.pem"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/argon2/**"
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GymApp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GymApp",
      "deleteAppDataOnUninstall": false
    }
  }
}
